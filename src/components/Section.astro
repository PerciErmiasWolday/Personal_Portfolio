---
/**
 * A page section: hairline rule with registration marks, a heading row with
 * an optional mono label, then the content.
 */
interface Props {
  id?: string;
  title: string;
  label?: string;
  class?: string;
}

const { id, title, label, class: className } = Astro.props;
const headingId = `${id ?? title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-title`;
---

<section id={id} class:list={['section', className]} aria-labelledby={headingId}>
  <div class="container">
    <div class="rule" aria-hidden="true"></div>
    <div class="section-head">
      <h2 id={headingId}>{title}</h2>
      {label && <p class="label">{label}</p>}
    </div>
    <slot />
  </div>
</section>
