---

<ul class:list={['social', className]} role="list">
  {
    site.social.map((s) => (
      <li>
        <a href={s.url} rel="me noopener" target="_blank" aria-label={`${s.label} (opens in a new tab)`}>
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path fill="currentColor" d={paths[s.icon]} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    color: var(--ink-soft);
    transition: color var(--quick);
  }

  a:hover {
    color: var(--terra);
  }

  svg {
    width: 18px;
    height: 18px;
  }
</style>
