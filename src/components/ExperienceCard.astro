---
/**
 * Compact experience card for the home page.
 * Its six parts sit on a shared subgrid (set up by the parent list), so
 * headers, titles, chips, descriptions and tech line up across the row.
 */
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'experience'>;
}

const { entry } = Astro.props;
const e = entry.data;
const { Content } = await render(entry);
const titleId = `exp-${entry.id}-title`;
const hasNumber = (s: string) => /\d/.test(s);
---

<article class="xcard" aria-labelledby={titleId}>
  <div class="xcard__head">
    <span class="label">{e.category}</span>
    <span class="label xcard__date">{e.end ? `${e.start} – ${e.end}` : e.start}</span>
  </div>

  <h3 class="xcard__role" id={titleId}>{e.role}</h3>

  <p class="xcard__org">{e.organization}</p>

  <ul class="xcard__chips" role="list" aria-label="Highlights">
    {e.chips.map((c) => <li class:list={['xchip', hasNumber(c) && 'xchip--metric']}>{c}</li>)}
  </ul>

  <div class="xcard__desc">
    <Content />
  </div>

  <ul class="chips xcard__stack" role="list" aria-label="Technologies">
    {e.stack.map((s) => <li class="chip">{s}</li>)}
  </ul>
</article>

<style>
  .xcard {
    display: grid;
    grid-row: span 6;
    grid-template-rows: subgrid;
    row-gap: var(--space-3);
    padding: 1.375rem;
    background-color: var(--card-rest);
    border: 1px solid var(--rule-strong);
    border-radius: 14px;
  }

  /* The date moves under the category when the card is too narrow for both */
  .xcard__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.15rem var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--rule);
  }

  .xcard__date {
    white-space: nowrap;
    color: var(--ink);
  }

  .xcard__role {
    align-self: end;
    font-size: var(--fs-h4);
    font-weight: 400;
    line-height: 1.2;
  }

  .xcard__org {
    margin-top: calc(var(--space-2) * -1);
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.4;
    color: var(--terra-text);
  }

  .xcard__chips {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: var(--space-2);
  }

  .xchip {
    padding: 6px 10px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--ink);
  }

  .xchip--metric {
    background: rgba(180, 85, 47, 0.12);
    border-color: rgba(142, 63, 33, 0.22);
    color: var(--terra-deep);
  }

  .xcard__desc {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--ink-2);
  }

  /* Fills the shared bottom row, so the divider lines up across cards */
  .xcard__stack {
    align-content: flex-start;
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  .xcard__stack .chip {
    font-size: 0.68rem;
    color: var(--ink-soft);
  }
</style>
