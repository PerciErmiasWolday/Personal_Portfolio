---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  items: CollectionEntry<'experience'>[];
  /** Show the highlight bullets (used on /about). */
  highlights?: boolean;
  headingLevel?: 'h3' | 'h4';
}

const { items, highlights = false, headingLevel: H = 'h3' } = Astro.props;
const rows = await Promise.all(
  items.map(async (entry) => {
    const { Content } = await render(entry);
    return { e: entry.data, Content, hasBody: Boolean(entry.body?.trim()) };
  }),
);
---

<ol class="timeline" role="list">
  {
    rows.map(({ e, Content, hasBody }) => (
      <li class="timeline__row">
        <div class="timeline__when">
          <p class="timeline__dates label">{e.end ? `${e.start} to ${e.end}` : e.start}</p>
          {e.location && <p class="timeline__location label">{e.location}</p>}
        </div>

        <div class="timeline__body">
          <H class="timeline__role">{e.role}</H>
          <p class="timeline__org">{e.organization}</p>
          {e.tags.length > 0 && <p class="timeline__tags label">{e.tags.join(' · ')}</p>}
          {hasBody ? (
            <div class="timeline__desc">
              <Content />
            </div>
          ) : (
            e.summary && <p class="timeline__desc">{e.summary}</p>
          )}
          {highlights && e.highlights.length > 0 && (
            <ul class="timeline__highlights">
              {e.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          )}
        </div>

        {(e.achievements.length > 0 || e.methods.length > 0 || e.stack.length > 0) && (
          <div class="timeline__aside">
            {e.achievements.length > 0 && (
              <ul class="badges" role="list" aria-label="Results">
                {e.achievements.map((a) => (
                  <li class="badge">
                    <span class="badge__value">{a.value}</span> {a.label}
                  </li>
                ))}
              </ul>
            )}
            {e.methods.length > 0 && (
              <ul class="chips timeline__methods" role="list" aria-label="Methods">
                {e.methods.map((m) => (
                  <li class="chip">{m}</li>
                ))}
              </ul>
            )}
            {e.stack.length > 0 && (
              <ul class="chips timeline__stack" role="list" aria-label="Technologies">
                {e.stack.map((s) => (
                  <li class="chip">{s}</li>
                ))}
              </ul>
            )}
          </div>
        )}
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    border-top: 1px solid var(--rule-strong);
  }

  .timeline__row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-4);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--rule-strong);
  }

  .timeline__when {
    grid-column: 1 / span 2;
    padding-top: 0.45em;
  }

  .timeline__dates {
    color: var(--terra-text);
  }

  .timeline__location {
    margin-top: var(--space-1);
  }

  .timeline__body {
    grid-column: 3 / span 7;
    max-width: var(--measure);
  }

  .timeline__aside {
    grid-column: 10 / -1;
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding-top: 0.35em;
  }

  .timeline__role {
    font-size: var(--fs-h4);
    font-weight: 400;
  }

  .timeline__org {
    margin-top: var(--space-1);
    color: var(--terra-text);
    font-weight: 500;
  }

  .timeline__tags {
    margin-top: var(--space-2);
  }

  .timeline__desc {
    margin-top: var(--space-3);
    color: var(--ink-2);
  }

  .timeline__desc :global(strong) {
    font-weight: 500;
    color: var(--ink);
  }

  .timeline__highlights {
    margin-top: var(--space-3);
    padding-left: 1.1em;
    color: var(--ink-soft);
    font-size: var(--fs-small);
  }

  .timeline__highlights li + li {
    margin-top: var(--space-1);
  }

  .timeline__highlights li::marker {
    color: var(--terra);
  }

  .timeline__methods .chip {
    border-color: var(--terra);
    color: var(--terra-text);
  }

  /* Technologies stay quiet */
  .timeline__stack .chip {
    font-size: 0.68rem;
    color: var(--ink-soft);
  }

  @media (max-width: 1023.98px) {
    .timeline__when {
      grid-column: 1 / span 3;
    }

    .timeline__body,
    .timeline__aside {
      grid-column: 4 / -1;
    }
  }

  @media (max-width: 767.98px) {
    .timeline__when,
    .timeline__body,
    .timeline__aside {
      grid-column: 1 / -1;
    }

    .timeline__when {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--space-4);
      padding-top: 0;
    }

    .timeline__location {
      margin-top: 0;
    }
  }
</style>
